# Environment
.env
.env.local

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/

# Node
node_modules/
frontend/dist/
frontend/.env

# Data (local databases — never commit)
# Covers both root data/ and backend/data/ since .env paths resolve relative to cwd
data/sqlite/
data/chroma/
data/neo4j/
backend/data/

# Runtime
logs/
.pids/
voice/recordings/

# Vendored SearXNG tree — cloned and configured by scripts/install.sh,
# never committed (third-party source, ~128MB)
searxng/

# Rust / Tauri (M16 desktop shell)
src-tauri/target/
src-tauri/gen/

# macOS
.DS_Store
.AppleDouble

# Conductor — personal, machine-local overrides (references this dev's own
# data/paths; .conductor/settings.toml is the shared, committed config)
.conductor/settings.local.toml
