# ─── ARIA Environment Variables ───────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit your actual .env file.

# FastAPI Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-this-to-a-random-secret

# SQLite
SQLITE_DB_PATH=./data/sqlite/aria.db

# ChromaDB
CHROMA_DB_PATH=./data/chroma

# Neo4j
# After first launch, visit http://localhost:7474
# Log in with neo4j / neo4j, then set a new password below
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password-here

# AI Providers — at least one key is required for chat.
# The first configured provider (in this order: Anthropic, OpenAI, Google,
# xAI, Perplexity) becomes ARIA's default. Leave a key blank to disable
# that provider.
#   Anthropic:  https://console.anthropic.com
#   OpenAI:     https://platform.openai.com
#   Google:     https://aistudio.google.com
#   xAI:        https://console.x.ai
#   Perplexity: https://www.perplexity.ai/settings/api
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=

# Frontend (used by Vite dev server only)
VITE_API_BASE_URL=http://localhost:8000
