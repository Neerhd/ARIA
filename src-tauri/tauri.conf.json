{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARIA",
  "version": "0.1.0",
  "identifier": "com.neerhdeka.aria",
  "build": {
    "beforeDevCommand": "npm run build --prefix frontend",
    "beforeBuildCommand": "npm run build --prefix frontend",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
