{
	"name": "aria",
	"base": "main",
	"copy": [".env"],
	"link": ["frontend/node_modules"],
	"backend": {
		"cwd": "backend",
		"start": ".venv/bin/python -m uvicorn main:app --port $PORT",
		"health": "/health"
	},
	"services": {
		"web": {
			"cwd": "frontend",
			"start": "npx vite --port $PORT --strictPort",
			"open": true,
			"health": "/",
			"env": { "API_URL": "{{backend.url}}" }
		}
	}
}
